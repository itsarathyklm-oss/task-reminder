[TEMPLATE]
# Server
PORT=4000

# Database (Aiven MySQL)
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=defaultdb
DB_SSL=true

# JWT (REQUIRED — app will not start without this)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-secret-string

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your@email.com

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS (set to your production URL)
ALLOWED_ORIGIN=https://your-app.onrender.com
